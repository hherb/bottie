{
  "name": "bottie",
  "version": "0.9.0",
  "description": "A local-first, provider-flexible desktop chatbot with persistent memory.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=forks --maxWorkers=1 --exclude \"website/**\" --exclude \"assets/**\"",
    "performance:frontend": "vitest run src/lib/performance.test.ts --mode performance --pool=forks --maxWorkers=1",
    "performance:native": "cargo test --manifest-path src-tauri/Cargo.toml performance_budget -- --ignored --nocapture",
    "performance:test": "npm run performance:frontend && npm run performance:native",
    "python:appcontainer:prove": "node scripts/windows-python-appcontainer.mjs --prove",
    "python:xpc:prove": "node scripts/macos-python-xpc.mjs --prove",
    "dependencies:check": "node scripts/dependency-inventory.mjs --check",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "release:assets:check": "node scripts/release-assets.mjs --check",
    "icons:generate": "node scripts/application-icons.mjs --generate",
    "icons:check": "node scripts/application-icons.mjs --check",
    "package:macos": "node scripts/macos-package.mjs --build",
    "package:macos:sign-development": "node scripts/macos-package.mjs --development-sign",
    "package:macos:inspect": "node scripts/macos-package.mjs --inspect",
    "package:macos:smoke": "node scripts/macos-package.mjs --smoke",
    "package:macos:distribution": "node scripts/macos-distribution.mjs --run",
    "package:windows": "node scripts/windows-package.mjs --build",
    "package:windows:inspect": "node scripts/windows-package.mjs --inspect",
    "package:windows:smoke": "node scripts/windows-package.mjs --smoke",
    "package:windows:test": "node --test scripts/windows-package.contract.mjs",
    "package:windows:distribution": "node scripts/windows-distribution.mjs --run",
    "package:windows:store": "node scripts/windows-store.mjs --build",
    "package:windows:store:test": "node --test scripts/windows-store.contract.mjs",
    "package:linux": "node scripts/linux-package.mjs --build",
    "package:linux:inspect": "node scripts/linux-package.mjs --inspect",
    "package:linux:smoke": "node scripts/linux-package.mjs --smoke",
    "package:linux:test": "node --test scripts/linux-package.contract.mjs",
    "package:linux:distribution": "node scripts/linux-distribution.mjs --run",
    "package:linux:distribution:test:integration": "node scripts/linux-distribution.integration.mjs",
    "update:contract:test": "vitest run scripts/update-delivery.test.mjs --pool=forks --maxWorkers=1",
    "release:candidate": "node scripts/release-candidate.mjs --write",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"scripts/**/*.mjs\" \"static/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"scripts/**/*.mjs\" \"static/**/*.js\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "node scripts/macos-development-signing.mjs --tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

FROM nvcr.io/nvidia/pytorch@sha256:417cbf33f87b5378849df37983552cd1f8bc8b62fe1ceabe004de816a55dff21

COPY requirements-diffusers-proof.txt /opt/bottie/requirements-diffusers-proof.txt
RUN python -m pip install --no-cache-dir --no-deps \
    -r /opt/bottie/requirements-diffusers-proof.txt

ADD --checksum=sha256:4fc8f67637f4c92b989a07d80ffe755e79a3510ca02ebf23ce66396fb277c88d \
    https://download.pytorch.org/whl/cu130/torch-2.10.0%2Bcu130-cp312-cp312-manylinux_2_28_aarch64.whl \
    /tmp/torch-2.10.0+cu130-cp312-cp312-manylinux_2_28_aarch64.whl
RUN python -m pip install --no-cache-dir --no-deps --force-reinstall \
    /tmp/torch-2.10.0+cu130-cp312-cp312-manylinux_2_28_aarch64.whl \
    && rm /tmp/torch-2.10.0+cu130-cp312-cp312-manylinux_2_28_aarch64.whl

COPY mlx_worker.py diffusers_worker.py diffusers_pytorch_worker.py /opt/bottie/
WORKDIR /opt/bottie

ENV HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TRANSFORMERS_OFFLINE=1

ENTRYPOINT ["python", "/opt/bottie/diffusers_pytorch_worker.py"]

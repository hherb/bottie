<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime microphone access. Without this entitlement macOS delivers silent buffers
	     (and never prompts), so native capture appears to work while every sample is zero. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>

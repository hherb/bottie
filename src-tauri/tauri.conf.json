{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bottie",
  "version": "0.9.0",
  "identifier": "com.bottie.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "bottie",
        "width": 1320,
        "height": 820,
        "minWidth": 720,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost",
        "default-src": "'self'",
        "font-src": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' bottie-attachment: http://bottie-attachment.localhost",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../LICENSE": "LICENSE",
      "../MODEL-NOTICE.txt": "MODEL-NOTICE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
